<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #ebdacc; -fx-background-image: resources/images/library_login.jpg;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.loginPageController">
