<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.loginPageController">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="141.0" layoutY="47.0" prefHeight="38.0" prefWidth="262.0" text="Login Page" textFill="#b74242" textOverrun="CENTER_ELLIPSIS">
         <font>
            <Font name="Calibri Bold" size="48.0" />
         </font>
      </Label>
      <Label layoutX="75.0" layoutY="152.0" prefHeight="18.0" prefWidth="115.0" text="User Name">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="75.0" layoutY="186.0" prefHeight="18.0" prefWidth="115.0" text="Password">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="txtUserName" layoutX="215.0" layoutY="153.0" prefHeight="26.0" prefWidth="226.0" />
      <PasswordField fx:id="txtPassword" layoutX="215.0" layoutY="188.0" prefHeight="26.0" prefWidth="226.0" />
      <Button layoutX="98.0" layoutY="245.0" mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="26.0" prefWidth="94.0" text="Log In">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button layoutX="300.0" layoutY="245.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="26.0" prefWidth="94.0" text="Clear">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
